# Copy to .env and adjust. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=packagegate
POSTGRES_PASSWORD=packagegate
POSTGRES_DB=packagegate
POSTGRES_PORT=5432
DATABASE_URL=postgresql://packagegate:packagegate@127.0.0.1:5432/packagegate

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# npm registry
# ---------------------------------------------------------------------------
NPM_REGISTRY_URL=https://registry.npmjs.org
# Identifies us to the registry. Be a polite automated client.
NPM_USER_AGENT=packagegate/0.1.0

# ---------------------------------------------------------------------------
# Known security intelligence
# ---------------------------------------------------------------------------
# Optional. Without a token the GitHub advisory API is heavily rate limited.
# A fine-grained token with NO scopes is sufficient — advisories are public.
GITHUB_TOKEN=
OSV_API_URL=https://api.osv.dev

# ---------------------------------------------------------------------------
# Scanner limits — the defensive budgets applied to hostile artifacts.
# Lower these if you are scanning untrusted input on a constrained host.
# ---------------------------------------------------------------------------
SCANNER_MAX_COMPRESSED_BYTES=67108864
SCANNER_MAX_EXTRACTED_BYTES=268435456
SCANNER_MAX_FILE_BYTES=16777216
SCANNER_MAX_FILE_COUNT=20000
SCANNER_MAX_COMPRESSION_RATIO=120
SCANNER_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Optional AI investigator.
# PackageGate is fully functional with AI_PROVIDER=none. The AI explains
# evidence; it never produces the risk score and never creates findings.
# ---------------------------------------------------------------------------
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
