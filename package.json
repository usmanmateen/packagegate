{
  "name": "packagegate",
  "version": "0.1.0",
  "private": true,
  "description": "npm supply-chain Trust & Safety investigation platform",
  "keywords": [
    "npm",
    "supply-chain",
    "security",
    "static-analysis",
    "malware-analysis",
    "trust-and-safety",
    "sbom",
    "dependency-security"
  ],
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @packagegate/cli exec node ./dist/bin.js evaluate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "packagegate": "pnpm --filter @packagegate/cli exec node ./dist/bin.js",
    "scan": "pnpm --filter @packagegate/cli exec node ./dist/bin.js scan"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
